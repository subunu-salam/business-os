# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Neon Postgres connection string — use the POOLED one (host contains "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign login sessions. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: password given to the demo accounts when the database is first seeded.
# DEMO_PASSWORD=Demo@2026

NODE_ENV=production
